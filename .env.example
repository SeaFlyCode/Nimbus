# Environnement
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Meteo-France (portail-api.meteofrance.fr)
# Voir README.md pour la procedure d'obtention du token.
METEOFRANCE_BASE_URL=https://portail-api.meteofrance.fr
METEOFRANCE_TOKEN=changeme
METEOFRANCE_TIMEOUT_MS=8000
METEOFRANCE_RETRY_COUNT=2

# Redis
REDIS_URL=redis://localhost:6379

# Cles API clients, format "nom:cle,nom2:cle2". Vide = pas d'auth (dev uniquement).
API_KEYS=mobile-app:changeme-mobile-key,web-app:changeme-web-key

# Rate limiting (par cle API, fallback par IP si pas de cle)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Frequence de polling Meteo-France (ms)
RADAR_POLL_INTERVAL_MS=300000
FORECAST_POLL_INTERVAL_MS=900000
ALERTS_POLL_INTERVAL_MS=900000

# Nombre d'images radar conservees pour l'animation /radar/history
RADAR_HISTORY_MAX_ITEMS=24

# Multiplicateur de l'intervalle de polling au-dela duquel une donnee est jugee "degraded" par /health
FRESHNESS_STALE_MULTIPLIER=2
